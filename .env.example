APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com:8118
APP_TIMEZONE=UTC

APP_DOMAIN=yourdomain.com
APP_PORT=8118

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_CHECK_INTERVAL=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

DISABLE_REGISTRATION=false

# Show reschedule count badge on tasks rescheduled at least this many times (0 = always show)
RESCHEDULE_BADGE_THRESHOLD=5

PAGINATION_PER_PAGE=100

MAX_FILE_SIZE=22M
SCALE_LARGEST_TO=2048

# Maximum total characters accepted in the task name/bulk-input field.
BULK_INPUT_MAX_CHARS=10000
# Maximum number of lines (tasks) in a single bulk submission.
BULK_INPUT_MAX_LINES=100
# Maximum characters for long text fields: task/project descriptions and comments.
LONG_TEXT_MAX_CHARS=10000

VITE_APP_NAME="${APP_NAME}"

TODOIST_KEY=


TOAST_UNDO_DURATION_MS=2000

# URL template for map links on tasks with show_map enabled.
# %s is replaced with the URL-encoded location string.
# Swap to another service (e.g. maps.apple.com/?address=%s) as needed.
MAPS_URL_TEMPLATE=https://maps.google.com/?q=%s

# Characters of location to show in task list rows before truncating with "…".
# Set to 0 to disable truncation.
LOCATION_TRUNCATE_LENGTH=30

HUMAN_DATE_FORMAT=Y-m-d
