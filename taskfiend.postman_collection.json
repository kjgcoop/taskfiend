{
  "info": {
    "name": "Task Fiend",
    "description": "Complete collection for the Task Fiend API and web endpoints.\n\n## Setup\n1. Set collection variables: `base_url`, `email`, `password`, `api_key`.\n2. Run **Auth → Get CSRF Token** first — it extracts the token and stores it in `csrf_token`.\n3. Run **Auth → Login** to establish a session cookie (required for all web routes).\n4. For API routes under the **API** folder, only `api_key` is needed (Bearer token).\n\n## Notes\n- Web routes use Laravel session cookies + CSRF tokens (handled automatically by the pre-request scripts below).\n- Replace `{task}`, `{project}`, `{tag}`, `{id}` path params with real IDs before sending.\n- `date` params use `YYYY-MM-DD` format.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "email",    "value": "test@example.com",     "type": "string" },
    { "key": "password", "value": "password123",           "type": "string" },
    { "key": "api_key",  "value": "tfk_YOUR_KEY_HERE",    "type": "string" },
    { "key": "csrf_token", "value": "",                   "type": "string" },
    { "key": "task_id",    "value": "1",                  "type": "string" },
    { "key": "project_id", "value": "1",                  "type": "string" },
    { "key": "tag_id",     "value": "1",                  "type": "string" },
    { "key": "comment_id",    "value": "1",               "type": "string" },
    { "key": "attachment_id", "value": "1",               "type": "string" },
    { "key": "user_id",       "value": "1",               "type": "string" }
  ],
  "item": [

    {
      "name": "Auth",
      "item": [
        {
          "name": "Get CSRF Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Extract the CSRF token from the <meta name=\"csrf-token\"> tag",
                  "const html = pm.response.text();",
                  "const match = html.match(/name=\"csrf-token\"\\s+content=\"([^\"]+)\"/);",
                  "if (match) {",
                  "    pm.collectionVariables.set('csrf_token', match[1]);",
                  "    console.log('CSRF token saved:', match[1]);",
                  "} else {",
                  "    console.warn('CSRF token not found in response');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// After login Laravel redirects to /; a 302 means success.",
                  "pm.test('Login succeeded (redirect)', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" },
              { "key": "Accept",       "value": "text/html,application/xhtml+xml" },
              { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "_token",   "value": "{{csrf_token}}" },
                { "key": "email",    "value": "{{email}}" },
                { "key": "password", "value": "{{password}}" }
              ]
            },
            "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "_token", "value": "{{csrf_token}}" }
              ]
            },
            "url": { "raw": "{{base_url}}/logout", "host": ["{{base_url}}"], "path": ["logout"] }
          }
        }
      ]
    },

    {
      "name": "API (Bearer Token)",
      "description": "These three endpoints use `Authorization: Bearer <api_key>` — no cookies or CSRF needed.",
